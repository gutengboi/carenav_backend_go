# Copy this file to /etc/carenav/api.env on the VM (chmod 600, not committed to git)
# and fill in real values. systemd's EnvironmentFile loads these for the
# docker run command in carenav-api.service.

PORT=3000
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/dbname
JWT_SECRET=
SECRET=
RESET_TOKEN_SECRET=
STREAM_API_KEY=
STREAM_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
